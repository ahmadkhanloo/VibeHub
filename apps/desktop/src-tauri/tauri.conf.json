{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VibeHub",
  "version": "0.1.0",
  "identifier": "com.ahmadkhanloo.vibehub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VibeHub",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../docs/legal/THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "../../../themes/terminal/mak-devline.omp.json": "themes/terminal/mak-devline.omp.json",
      "../../../apps/rtl-direction.mjs": "apps/rtl-direction.mjs",
      "../../../apps/Qoder/start.ps1": "apps/Qoder/start.ps1",
      "../../../apps/Qoder/launch.vbs": "apps/Qoder/launch.vbs",
      "../../../apps/Qoder/injector.mjs": "apps/Qoder/injector.mjs",
      "../../../apps/Qoder/style.mjs": "apps/Qoder/style.mjs",
      "../../../apps/Qoder/doctor.mjs": "apps/Qoder/doctor.mjs",
      "../../../apps/Qoder/LICENSE": "apps/Qoder/LICENSE",
      "../../../apps/Qoder/assets/": "apps/Qoder/assets/",
      "../../../apps/ZCode/start.ps1": "apps/ZCode/start.ps1",
      "../../../apps/ZCode/launch.vbs": "apps/ZCode/launch.vbs",
      "../../../apps/ZCode/injector.mjs": "apps/ZCode/injector.mjs",
      "../../../apps/DeepSeekHarness/start.ps1": "apps/DeepSeekHarness/start.ps1",
      "../../../apps/DeepSeekHarness/launch.vbs": "apps/DeepSeekHarness/launch.vbs",
      "../../../apps/DeepSeekHarness/injector.mjs": "apps/DeepSeekHarness/injector.mjs",
      "../../../apps/DeepSeekHarness/assets/": "apps/DeepSeekHarness/assets/",
      "../../../apps/rtl-paths.ps1": "apps/rtl-paths.ps1",
      "../../../apps/migrate-agentrtl-paths.ps1": "apps/migrate-agentrtl-paths.ps1",
      "../../../cleanup.ps1": "cleanup.ps1",
      "windows/payload/node.exe": "runtime/node.exe",
      "windows/payload/NODE-LICENSE.md": "licenses/NODE-LICENSE.md",
      "../../../apps/Antigravity/start.ps1": "apps/Antigravity/start.ps1",
      "../../../apps/Antigravity/launch.vbs": "apps/Antigravity/launch.vbs",
      "../../../apps/Antigravity/injector.mjs": "apps/Antigravity/injector.mjs",
      "../../../apps/Antigravity/style.mjs": "apps/Antigravity/style.mjs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Farsi"
        ],
        "customLanguageFiles": {
          "Farsi": "windows/Farsi.nsh"
        },
        "installMode": "currentUser",
        "startMenuFolder": "VibeHub",
        "installerHooks": "windows/installer-hooks.nsh",
        "template": "windows/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVERjVGQzQ4MzgzMkZEOEIKUldTTC9USTRTUHoxN2RyY2hrTUNIUUQySXlsdHRKMHJlUGRCSktudXdLd2c5di9wZmwydi9pZ1kK",
      "endpoints": [
        "https://github.com/ahmadkhanloo/VibeHub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
